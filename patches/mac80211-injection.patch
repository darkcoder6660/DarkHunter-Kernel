@@ -1393,9 +1393,7 @@ int cfg80211_set_monitor_channel(struct cfg80211_registered_device *rdev,
 {
 	if (!rdev->ops->set_monitor_channel)
 		return -EOPNOTSUPP;
-	if (!cfg80211_has_monitors_only(rdev))
-		return -EBUSY;
-
+	/* allow monitor channel change even with a normal vif present */
 	return rdev_set_monitor_channel(rdev, chandef);
 }
 
